{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "cra-template": "1.2.0",
    "emailjs": "^4.0.3",
    "prop-types": "^15.8.1",
    "puppeteer": "^24.37.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "sync": "node --env-file-if-exists=.env scripts/sync-cosmos.mjs",
    "prebuild": "npm run content:check",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:content": "node --test \"scripts/*.test.mjs\"",
    "test:api": "node --test \"api/test/*.test.mjs\"",
    "test:app": "react-scripts test --watchAll=false --runInBand",
    "test:all": "npm run test:content && npm run test:api && npm run test:app",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@azure/cosmos": "^4.10.2",
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "typescript-eslint": "^8.24.0"
  }
}
