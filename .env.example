# Copy to .env (gitignored) and fill in. Never commit real keys.

# Azure Cosmos DB: portal > cosmos-kazishahriar > Settings > Keys > Read-write Keys
COSMOS_ENDPOINT=https://cosmos-kazishahriar.documents.azure.com:443/
COSMOS_KEY=
# Optional, these are the defaults:
# COSMOS_DATABASE=portfolio
# COSMOS_CONTAINER=content

# Azure AI Foundry (Document Intelligence + Azure OpenAI) for `npm run ingest`
# portal > aif-kazishahriar > Resource Management > Keys and Endpoint
AZURE_AI_ENDPOINT=https://aif-kazishahriar.cognitiveservices.azure.com/
AZURE_AI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
